@using Priser.Models.Entities
@{
    ViewBag.Title = "Marketplace – Priser";
    var products = ViewBag.Products as List<Product> ?? [];
    var categories = ViewBag.Categories as List<string> ?? [];
    var balance = (decimal)(ViewBag.WalletBalance ?? 0);
}

<header class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-3xl font-bold text-primary-container">Marketplace</h1>
        <p class="text-on-surface-variant mt-1">Troque seus pontos por recompensas incríveis.</p>
    </div>
    <div class="flex items-center gap-3">
        <span class="text-sm font-bold text-secondary border border-secondary px-4 py-2 rounded-full flex items-center gap-2">
            <span class="ms text-[16px]">stars</span> @balance.ToString("N0") pts
        </span>
        <a href="/marketplace/orders" class="btn-outline text-sm px-4 py-2">Meus Pedidos</a>
    </div>
</header>

<!-- Search & Filter -->
<div class="card p-4 mb-6 flex flex-wrap gap-3 items-center">
    <form method="get" class="flex gap-2 flex-1 min-w-[200px]">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="Buscar produtos..."
               class="flex-1 border border-outline-variant rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-secondary"/>
        <button type="submit" class="btn-primary px-4 py-2 text-sm">
            <span class="ms text-[16px]">search</span>
        </button>
    </form>
    <div class="flex gap-2 flex-wrap">
        <a href="/marketplace" class="text-xs px-3 py-1.5 rounded-full font-semibold @(ViewBag.CategoryFilter == null ? "bg-secondary text-white" : "bg-surface-container text-on-surface-variant")">Todos</a>
        @foreach (var cat in categories)
        {
            <a href="/marketplace?category=@cat" class="text-xs px-3 py-1.5 rounded-full font-semibold @(ViewBag.CategoryFilter?.ToString() == cat ? "bg-secondary text-white" : "bg-surface-container text-on-surface-variant hover:bg-surface-container-low")">@cat</a>
        }
    </div>
</div>

<!-- Products Grid -->
@if (!products.Any())
{
    <div class="card p-12 text-center">
        <span class="ms text-[64px] block mb-4 text-outline">redeem</span>
        <h3 class="text-xl font-semibold text-primary-container">Nenhum produto disponível</h3>
        <p class="text-on-surface-variant mt-2">O admin ainda não adicionou produtos ao marketplace.</p>
    </div>
}
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
    @foreach (var p in products)
    {
        var canAfford = balance >= p.PricePoints;
        <div class="card overflow-hidden flex flex-col">
            <div class="h-48 bg-surface-container flex items-center justify-center">
                @if (p.ImageUrl != null)
                {
                    <img src="@p.ImageUrl" alt="@p.Name" class="h-full w-full object-cover"/>
                }
                else
                {
                    <span class="ms text-[64px] text-on-surface-variant opacity-30">redeem</span>
                }
            </div>
            <div class="p-5 flex flex-col flex-1">
                <div class="flex items-start justify-between gap-2 mb-2">
                    <h3 class="font-bold text-primary-container">@p.Name</h3>
                    <span class="text-xs px-2 py-1 bg-surface-container rounded-full text-on-surface-variant flex-shrink-0">@p.Category</span>
                </div>
                @if (p.Description != null)
                {
                    <p class="text-sm text-on-surface-variant mb-4 flex-1">@p.Description</p>
                }
                <div class="flex items-center justify-between mt-auto pt-4 border-t border-outline-variant">
                    <span class="text-xl font-black text-secondary">@p.PricePoints.ToString("N0") pts</span>
                    @if (p.StockQuantity.HasValue && p.StockQuantity <= 0)
                    {
                        <span class="text-sm text-on-surface-variant font-semibold">Sem estoque</span>
                    }
                    else
                    {
                        <form method="post" action="/marketplace/redeem">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@p.Id"/>
                            <button type="submit" @(canAfford ? "" : "disabled")
                                    class="@(canAfford ? "btn-primary" : "bg-surface-container text-on-surface-variant cursor-not-allowed") px-4 py-2 text-sm rounded-lg font-semibold">
                                @(canAfford ? "Resgatar" : "Pts insuficientes")
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
