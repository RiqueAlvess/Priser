@using Priser.Models.Entities
@{
    ViewBag.Title = "Meus Pedidos – Priser";
    var orders = ViewBag.Orders as List<Order> ?? [];
}

<header class="mb-8">
    <h1 class="text-3xl font-bold text-primary-container">Meus Pedidos</h1>
    <a href="/marketplace" class="text-secondary text-sm hover:underline flex items-center gap-1 mt-1">
        <span class="ms text-[14px]">arrow_back</span> Voltar ao Marketplace
    </a>
</header>

@if (!orders.Any())
{
    <div class="card p-12 text-center">
        <span class="ms text-[64px] block mb-4 text-outline">shopping_bag</span>
        <h3 class="text-xl font-semibold text-primary-container">Nenhum pedido ainda</h3>
        <p class="text-on-surface-variant mt-2">Seus resgates aparecerão aqui.</p>
        <a href="/marketplace" class="btn-primary inline-flex items-center gap-2 mt-6">Ver Marketplace</a>
    </div>
}

<div class="space-y-4">
    @foreach (var o in orders)
    {
        var statusColor = o.Status switch {
            "processing" => "bg-yellow-100 text-yellow-800",
            "completed"  => "bg-green-100 text-green-800",
            "cancelled"  => "bg-red-100 text-red-800",
            _            => "bg-surface-container text-on-surface-variant"
        };
        <div class="card p-6">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <div>
                    <p class="font-bold text-primary-container">Pedido #@o.Id.ToString()[..8].ToUpper()</p>
                    <p class="text-xs text-on-surface-variant">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <span class="text-xs px-3 py-1.5 rounded-full font-semibold @statusColor">@o.Status.ToUpper()</span>
            </div>
            <div class="space-y-3">
                @foreach (var item in o.Items)
                {
                    <div class="flex items-center justify-between gap-4 py-2 border-b border-outline-variant last:border-0">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-surface-container rounded-lg flex items-center justify-center">
                                <span class="ms text-on-surface-variant">redeem</span>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-primary-container">@item.Product.Name</p>
                                <p class="text-xs text-on-surface-variant">Qty: @item.Quantity</p>
                            </div>
                        </div>
                        <span class="font-bold text-secondary">@item.TotalPoints.ToString("N0") pts</span>
                    </div>
                }
            </div>
            <div class="flex justify-end mt-3">
                <span class="font-bold text-primary-container">Total: @o.TotalPoints.ToString("N0") pts</span>
            </div>
        </div>
    }
</div>
