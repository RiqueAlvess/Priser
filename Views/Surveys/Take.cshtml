@using Priser.Models.Entities
@{
    ViewBag.Title = "Responder Pesquisa – Priser";
    var survey = ViewBag.Survey as Survey;
}

<header class="mb-8">
    <a href="/surveys" class="text-secondary text-sm hover:underline flex items-center gap-1 mb-4">
        <span class="ms text-[14px]">arrow_back</span> Voltar às pesquisas
    </a>
    <h1 class="text-3xl font-bold text-primary-container">@survey?.Title</h1>
    @if (survey?.Description != null)
    {
        <p class="text-on-surface-variant mt-2">@survey.Description</p>
    }
    @if (survey?.RewardPoints > 0)
    {
        <div class="mt-3 inline-flex items-center gap-2 text-secondary font-bold">
            <span class="ms">stars</span> +@survey.RewardPoints pontos ao concluir
        </div>
    }
</header>

<div class="max-w-2xl">
    <div class="card p-8">
        <form method="post" action="/surveys/submit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="surveyId" value="@survey?.Id"/>

            <div class="space-y-8">
                @foreach (var q in survey?.Questions.OrderBy(q => q.DisplayOrder) ?? [])
                {
                    <div>
                        <label class="block text-sm font-semibold text-primary-container mb-3">
                            @q.DisplayOrder. @q.Text
                            @if (q.IsRequired) { <span class="text-error">*</span> }
                        </label>
                        @if (q.QuestionType == "rating")
                        {
                            <div class="flex gap-2">
                                @for (int i = 1; i <= 10; i++)
                                {
                                    <label class="cursor-pointer flex-1">
                                        <input type="radio" name="answers[@q.Id]" value="@i" @(q.IsRequired ? "required" : "") class="sr-only peer"/>
                                        <div class="text-center p-2 border-2 border-outline-variant rounded-lg text-sm font-bold peer-checked:border-secondary peer-checked:bg-blue-50 peer-checked:text-secondary hover:border-secondary/50 transition-all">
                                            @i
                                        </div>
                                    </label>
                                }
                            </div>
                            <div class="flex justify-between text-xs text-on-surface-variant mt-1">
                                <span>Discordo totalmente</span>
                                <span>Concordo totalmente</span>
                            </div>
                        }
                        else if (q.QuestionType == "text")
                        {
                            <textarea name="answers[@q.Id]" rows="3" @(q.IsRequired ? "required" : "")
                                      placeholder="Sua resposta..."
                                      class="w-full border border-outline-variant rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-secondary resize-none"></textarea>
                        }
                        else if (q.QuestionType == "nps")
                        {
                            <div class="flex gap-1.5">
                                @for (int i = 0; i <= 10; i++)
                                {
                                    var bg = i <= 6 ? "peer-checked:bg-red-500 peer-checked:border-red-500 peer-checked:text-white hover:border-red-400"
                                           : i <= 8 ? "peer-checked:bg-yellow-500 peer-checked:border-yellow-500 peer-checked:text-white hover:border-yellow-400"
                                                    : "peer-checked:bg-green-500 peer-checked:border-green-500 peer-checked:text-white hover:border-green-400";
                                    <label class="cursor-pointer flex-1">
                                        <input type="radio" name="answers[@q.Id]" value="@i" @(q.IsRequired ? "required" : "") class="sr-only peer"/>
                                        <div class="text-center p-2 border-2 border-outline-variant rounded-lg text-sm font-bold transition-all @bg">@i</div>
                                    </label>
                                }
                            </div>
                            <div class="flex justify-between text-xs text-on-surface-variant mt-1">
                                <span>😞 Não recomendaria</span>
                                <span>😍 Recomendaria com certeza</span>
                            </div>
                        }
                        else if (q.QuestionType == "choice" && q.Options != null)
                        {
                            var opts = q.Options.Split(',', StringSplitOptions.TrimEntries);
                            <div class="space-y-2">
                                @foreach (var opt in opts)
                                {
                                    <label class="flex items-center gap-3 cursor-pointer">
                                        <input type="radio" name="answers[@q.Id]" value="@opt" @(q.IsRequired ? "required" : "") class="accent-secondary"/>
                                        <span class="text-sm">@opt</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="mt-8 pt-6 border-t border-outline-variant">
                <button type="submit" class="btn-primary w-full py-4 text-base flex items-center justify-center gap-2">
                    <span class="ms">send</span> Enviar Respostas
                </button>
            </div>
        </form>
    </div>
</div>
