@using Priser.Models.Entities
@{
    ViewBag.Title = "Suporte — Priser System";
    var tenantAdmins = ViewBag.TenantAdmins as List<User> ?? new List<User>();
    var recentImpersonations = ViewBag.RecentImpersonations as List<AuditLog> ?? new List<AuditLog>();
}

<header class="mb-8">
    <h1 class="text-3xl font-bold text-primary-container">Suporte</h1>
    <p class="text-on-surface-variant mt-1">Impersonar Tenant Admin e fila de atendimento</p>
</header>

<div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-8">
    <!-- Impersonar Tenant Admin -->
    <section class="card p-6">
        <h2 class="text-lg font-bold text-primary-container mb-1 flex items-center gap-2">
            <span class="ms">manage_accounts</span> Impersonar Tenant Admin
        </h2>
        <p class="text-xs text-on-surface-variant mb-5">Acesso com log obrigatório de motivo. Toda ação fica registrada no audit log.</p>

        <form method="post" action="/system/support/impersonate" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-sm font-semibold mb-1.5">Tenant Admin *</label>
                <select name="userId" required class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary">
                    <option value="">Selecione o Tenant Admin</option>
                    @foreach (var admin in tenantAdmins)
                    {
                        <option value="@admin.Id">@admin.FullName — @(admin.Tenant?.Name ?? "?")</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-1.5">Motivo obrigatório *</label>
                <textarea name="reason" required rows="3" placeholder="Ex: Ticket #1234 — cliente relata problema no painel de reconhecimentos. Acessando para investigar o issue reportado."
                          class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary resize-none"></textarea>
                <p class="text-xs text-on-surface-variant mt-1">Este motivo fica permanentemente registrado no audit log.</p>
            </div>
            <div class="flex items-start gap-3 p-3 bg-yellow-50 border border-yellow-200 rounded-xl">
                <span class="ms text-yellow-600 mt-0.5">warning</span>
                <div class="text-xs text-yellow-800">
                    <p class="font-semibold mb-0.5">Atenção</p>
                    <p>Ao impersonar, você age em nome do Tenant Admin. Todas as ações dentro do painel serão registradas como realizadas por você. Só use para suporte legítimo.</p>
                </div>
            </div>
            <button type="submit" class="btn-primary w-full flex items-center justify-center gap-2">
                <span class="ms text-[16px]">person_check</span> Registrar impersonação
            </button>
        </form>
    </section>

    <!-- Histórico de impersonações -->
    <section class="card p-6">
        <h2 class="text-lg font-bold text-primary-container mb-4 flex items-center gap-2">
            <span class="ms">history</span> Últimas impersonações
        </h2>
        @if (recentImpersonations.Any())
        {
            <div class="space-y-3">
                @foreach (var log in recentImpersonations)
                {
                    <div class="p-3 border border-outline-variant rounded-xl">
                        <div class="flex items-start justify-between gap-2">
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-primary-container truncate">@(log.NewValue ?? "—")</p>
                                <p class="text-xs text-on-surface-variant">Por: @(log.UserId?.ToString()[..8] ?? "?") · IP: @(log.IpAddress ?? "—")</p>
                            </div>
                            <span class="text-xs text-on-surface-variant whitespace-nowrap">@log.CreatedAt.ToString("dd/MM HH:mm")</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-10 text-on-surface-variant">
                <span class="ms text-[36px] mb-2">history</span>
                <p class="text-sm">Nenhuma impersonação registrada.</p>
            </div>
        }
    </section>
</div>

<!-- Fila de tickets (simulada) -->
<section class="card p-6">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-primary-container flex items-center gap-2">
            <span class="ms">confirmation_number</span> Fila de suporte
        </h2>
        <span class="text-xs text-on-surface-variant bg-surface-container px-3 py-1.5 rounded-full">Integração com sistema de tickets em desenvolvimento</span>
    </div>

    @{
        var mockTickets = new[]
        {
            new { Id = "#1042", Tenant = "Empresa ABC", Issue = "Usuário não consegue fazer login após reset de senha", Priority = "alta", Status = "aberto", Created = "Hoje 09:14" },
            new { Id = "#1039", Tenant = "Corp XYZ", Issue = "Pontos do reconhecimento não apareceram na carteira", Priority = "média", Status = "em andamento", Created = "Ontem 16:30" },
            new { Id = "#1037", Tenant = "Startup JKL", Issue = "Erro ao criar pesquisa com mais de 10 perguntas", Priority = "baixa", Status = "aberto", Created = "03/06 11:00" },
            new { Id = "#1035", Tenant = "Empresa MNO", Issue = "Integração HRIS não sincronizando novos usuários", Priority = "alta", Status = "aguardando cliente", Created = "02/06 08:45" },
        };
    }
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead style="background:#f3f4f5">
                <tr class="text-xs text-on-surface-variant uppercase tracking-wide">
                    <th class="text-left px-4 py-3">Ticket</th>
                    <th class="text-left px-4 py-3">Tenant</th>
                    <th class="text-left px-4 py-3">Problema</th>
                    <th class="text-left px-4 py-3">Prioridade</th>
                    <th class="text-left px-4 py-3">Status</th>
                    <th class="text-left px-4 py-3">Criado</th>
                    <th class="text-left px-4 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @foreach (var t in mockTickets)
                {
                    var prioClass = t.Priority switch
                    {
                        "alta" => "bg-red-100 text-red-700",
                        "média" => "bg-yellow-100 text-yellow-700",
                        _ => "bg-gray-100 text-gray-600"
                    };
                    var statusClass = t.Status switch
                    {
                        "aberto" => "bg-blue-100 text-blue-700",
                        "em andamento" => "bg-indigo-100 text-indigo-700",
                        _ => "bg-gray-100 text-gray-600"
                    };
                    <tr class="hover:bg-surface-container-low">
                        <td class="px-4 py-3 font-mono text-xs font-semibold text-secondary">@t.Id</td>
                        <td class="px-4 py-3 font-semibold text-primary-container">@t.Tenant</td>
                        <td class="px-4 py-3 text-on-surface-variant max-w-xs truncate">@t.Issue</td>
                        <td class="px-4 py-3">
                            <span class="text-xs font-semibold px-2 py-1 rounded-full @prioClass">@t.Priority</span>
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-xs font-semibold px-2 py-1 rounded-full @statusClass">@t.Status</span>
                        </td>
                        <td class="px-4 py-3 text-xs text-on-surface-variant">@t.Created</td>
                        <td class="px-4 py-3">
                            <button class="p-1.5 rounded-lg hover:bg-surface-container text-secondary" title="Abrir ticket">
                                <span class="ms text-[16px]">open_in_new</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
