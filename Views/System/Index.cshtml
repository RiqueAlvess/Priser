@{
    ViewBag.Title = "Dashboard — Priser System";
    var mrr = ViewBag.MRR as decimal? ?? 0m;
    var arr = ViewBag.ARR as decimal? ?? 0m;
    var totalPoints = ViewBag.TotalPoints as decimal? ?? 0m;
    var totalTenants = ViewBag.TotalTenants as int? ?? 0;
    var suspendedTenants = ViewBag.SuspendedTenants as int? ?? 0;
    var totalUsers = ViewBag.TotalUsers as int? ?? 0;

    var recByDay = ViewBag.RecByDay as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var recList = recByDay.ToList();
    var maxRec = recList.Any() ? (int)recList.Max(r => (int)r.Count) : 1;
    if (maxRec == 0) maxRec = 1;

    var tenantsAtRisk = ViewBag.TenantsAtRisk as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var recentAudit = ViewBag.RecentAudit as IEnumerable<Priser.Models.Entities.AuditLog> ?? Enumerable.Empty<Priser.Models.Entities.AuditLog>();
}

<header class="mb-8">
    <h1 class="text-3xl font-bold text-primary-container">Dashboard</h1>
    <p class="text-on-surface-variant mt-1">Visão consolidada de toda a plataforma Priser</p>
</header>

<!-- KPIs -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="card p-5">
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mb-1">Tenants ativos</p>
        <p class="text-3xl font-bold text-primary-container">@totalTenants</p>
        @if (suspendedTenants > 0)
        {
            <p class="text-xs text-error mt-1">@suspendedTenants suspenso(s)</p>
        }
    </div>
    <div class="card p-5">
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mb-1">MRR</p>
        <p class="text-3xl font-bold text-primary-container">$@mrr.ToString("N0")</p>
        <p class="text-xs text-secondary mt-1">ARR $@arr.ToString("N0")</p>
    </div>
    <div class="card p-5">
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mb-1">Colaboradores</p>
        <p class="text-3xl font-bold text-primary-container">@totalUsers.ToString("N0")</p>
        <p class="text-xs text-on-surface-variant mt-1">usuários ativos</p>
    </div>
    <div class="card p-5">
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mb-1">Créditos emitidos</p>
        <p class="text-3xl font-bold text-primary-container">@(totalPoints > 1_000_000 ? $"{totalPoints / 1_000_000:N1}M" : totalPoints > 1000 ? $"{totalPoints / 1000:N1}k" : totalPoints.ToString("N0"))</p>
        <p class="text-xs text-on-surface-variant mt-1">últimos 30 dias</p>
    </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-5 gap-6 mb-8">
    <!-- Gráfico de reconhecimentos -->
    <section class="card p-6 xl:col-span-2">
        <h2 class="text-lg font-bold text-primary-container mb-4 flex items-center gap-2">
            <span class="ms">bar_chart</span> Reconhecimentos (últimos 7 dias)
        </h2>
        @if (recList.Any())
        {
            <div class="space-y-2">
                @foreach (var day in recList)
                {
                    var pct = maxRec > 0 ? (int)((int)day.Count * 100 / maxRec) : 0;
                    <div class="flex items-center gap-3">
                        <span class="text-xs text-on-surface-variant w-8">@((DateTime)day.Date).ToString("ddd", new System.Globalization.CultureInfo("pt-BR")).Substring(0,3)</span>
                        <div class="flex-1 bg-surface-container rounded-full h-6 overflow-hidden">
                            <div class="h-full rounded-full flex items-center px-2 text-xs text-white font-semibold transition-all" style="width:@(pct < 5 ? 5 : pct)%; background:#00658d">
                                @if (pct >= 15) { <span>@day.Count</span> }
                            </div>
                        </div>
                        <span class="text-xs font-semibold text-primary-container w-8 text-right">@day.Count</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-on-surface-variant text-sm">Sem dados de reconhecimentos ainda.</p>
        }
    </section>

    <!-- Tenants em atenção -->
    <section class="card p-6 xl:col-span-3">
        <h2 class="text-lg font-bold text-primary-container mb-4 flex items-center gap-2">
            <span class="ms">warning</span> Tenants em atenção
        </h2>
        @{
            var riskList = tenantsAtRisk.ToList();
        }
        @if (riskList.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-xs text-on-surface-variant uppercase tracking-wide">
                            <th class="text-left pb-2">Tenant</th>
                            <th class="text-left pb-2">Problema</th>
                            <th class="text-left pb-2">Risco</th>
                            <th class="text-left pb-2"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant">
                        @foreach (var item in riskList)
                        {
                            <tr>
                                <td class="py-3 font-semibold text-primary-container">@((item.Tenant as Priser.Models.Entities.Tenant)?.Name ?? "—")</td>
                                <td class="py-3 text-on-surface-variant">@item.Problem</td>
                                <td class="py-3">
                                    @if ((string)item.Risk == "alto")
                                    {
                                        <span class="text-xs font-bold px-2 py-1 rounded-full bg-red-100 text-red-700">alto</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs font-bold px-2 py-1 rounded-full bg-yellow-100 text-yellow-700">médio</span>
                                    }
                                </td>
                                <td class="py-3">
                                    <a href="/system/tenants/@((item.Tenant as Priser.Models.Entities.Tenant)?.Id)" class="text-xs text-secondary hover:underline">ver →</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-8 text-on-surface-variant">
                <span class="ms text-[40px] mb-2">check_circle</span>
                <p class="text-sm">Todos os tenants estão saudáveis</p>
            </div>
        }
    </section>
</div>

<!-- Log de atividade recente -->
<section class="card p-6">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-primary-container flex items-center gap-2">
            <span class="ms">history</span> Atividade recente na plataforma
        </h2>
        <a href="/system/audit" class="text-sm text-secondary hover:underline">Ver tudo →</a>
    </div>
    @{
        var auditList = recentAudit.ToList();
    }
    @if (auditList.Any())
    {
        <div class="space-y-2">
            @foreach (var log in auditList)
            {
                <div class="flex items-start gap-3 py-2 border-b border-outline-variant last:border-0">
                    <span class="ms text-[18px] text-on-surface-variant mt-0.5">bolt</span>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-primary-container truncate">@log.Action <span class="font-normal text-on-surface-variant">— @log.EntityType @(log.EntityId?.ToString()[..8] ?? "")</span></p>
                        @if (!string.IsNullOrWhiteSpace(log.NewValue))
                        {
                            <p class="text-xs text-on-surface-variant truncate">@log.NewValue</p>
                        }
                    </div>
                    <span class="text-xs text-on-surface-variant whitespace-nowrap">@log.CreatedAt.ToString("dd/MM HH:mm")</span>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-on-surface-variant text-sm">Nenhuma atividade registrada ainda.</p>
    }
</section>
