@using Priser.Models.Entities
@{
    ViewBag.Title = "Orçamentos – Admin";
    var budgets = ViewBag.Budgets as List<Budget> ?? [];
    var managers = ViewBag.Managers as List<User> ?? [];
}

<header class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-3xl font-bold text-primary-container">Orçamentos de Gestores</h1>
        <a href="/admin" class="text-secondary text-sm hover:underline">← Admin</a>
    </div>
    <button onclick="document.getElementById('budget-modal').classList.remove('hidden')" class="btn-primary flex items-center gap-2">
        <span class="ms" style="font-size:16px;font-family:'Material Symbols Outlined';font-style:normal">add</span> Novo Orçamento
    </button>
</header>

<div class="card overflow-hidden mb-6">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead style="background:#f3f4f5">
                <tr>
                    <th class="text-left px-6 py-3 text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Gestor</th>
                    <th class="text-left px-6 py-3 text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Total</th>
                    <th class="text-left px-6 py-3 text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Utilizado</th>
                    <th class="text-left px-6 py-3 text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Disponível</th>
                    <th class="text-left px-6 py-3 text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Renovação</th>
                    <th class="text-left px-6 py-3 text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @foreach (var b in budgets)
                {
                    var pct = b.TotalAmount > 0 ? (int)(b.SpentAmount / b.TotalAmount * 100) : 0;
                    var statusColor = b.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800";
                    <tr class="hover:bg-surface-container transition-colors">
                        <td class="px-6 py-4 font-semibold text-primary-container">@b.Manager.FullName</td>
                        <td class="px-6 py-4 font-bold text-secondary">@b.TotalAmount.ToString("N0") pts</td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2">
                                <div class="flex-1 h-2 bg-surface-container-high rounded-full overflow-hidden">
                                    <div class="h-full rounded-full transition-all" style="width:@pct%;background:#00658d"></div>
                                </div>
                                <span class="text-xs text-on-surface-variant">@pct%</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 font-bold text-primary-container">@b.RemainingAmount.ToString("N0") pts</td>
                        <td class="px-6 py-4 text-on-surface-variant">@b.RenewalPeriod · @b.NextRenewalDate.ToString("dd/MM/yyyy")</td>
                        <td class="px-6 py-4"><span class="text-xs px-2 py-1 rounded-full font-semibold @statusColor">@(b.IsActive ? "Ativo" : "Inativo")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Budget Modal -->
<div id="budget-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-8 w-full max-w-md shadow-2xl">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-primary-container">Criar Orçamento</h2>
            <button onclick="document.getElementById('budget-modal').classList.add('hidden')" class="text-on-surface-variant hover:text-primary-container">
                <span class="ms" style="font-family:'Material Symbols Outlined';font-style:normal">close</span>
            </button>
        </div>
        <form method="post" action="/admin/budgets/create">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Gestor *</label>
                <select name="managerId" required class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary">
                    <option value="">Selecione o gestor...</option>
                    @foreach (var m in managers)
                    {
                        <option value="@m.Id">@m.FullName</option>
                    }
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Total de Pontos *</label>
                <input type="number" name="totalAmount" required min="1" placeholder="Ex: 1000" class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary"/>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Periodicidade</label>
                <select name="renewalPeriod" class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary">
                    <option value="monthly">Mensal</option>
                    <option value="yearly">Anual</option>
                </select>
            </div>
            <div class="mb-6 flex items-center gap-3">
                <input type="checkbox" name="resetUnused" value="true" id="resetUnused" class="accent-secondary w-4 h-4"/>
                <label for="resetUnused" class="text-sm text-on-surface-variant">Zerar saldo não utilizado na renovação</label>
            </div>
            <div class="flex gap-3">
                <button type="button" onclick="document.getElementById('budget-modal').classList.add('hidden')" class="btn-outline flex-1">Cancelar</button>
                <button type="submit" class="btn-primary flex-1">Criar e Creditar</button>
            </div>
        </form>
    </div>
</div>
