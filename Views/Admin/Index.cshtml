@{
    ViewBag.Title = "Admin – Priser";
    var totalUsers = (int)(ViewBag.TotalUsers ?? 0);
    var totalRecs = (int)(ViewBag.TotalRecognitions ?? 0);
    var pendingAp = (int)(ViewBag.PendingApprovals ?? 0);
    var totalPts = (decimal)(ViewBag.TotalPointsIssued ?? 0);
}

<header class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-3xl font-bold text-primary-container">Painel Administrativo</h1>
        <p class="text-on-surface-variant mt-1">Gerencie sua organização e configurações.</p>
    </div>
</header>

<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 mb-10">
    <div class="card p-6">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Colaboradores</span>
            <span class="ms text-secondary" style="font-size:28px;font-family:'Material Symbols Outlined';font-style:normal">group</span>
        </div>
        <p class="text-4xl font-black text-primary-container">@totalUsers</p>
        <p class="text-xs text-on-surface-variant mt-1">usuários ativos</p>
    </div>
    <div class="card p-6">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Reconhecimentos</span>
            <span class="ms text-secondary" style="font-size:28px;font-family:'Material Symbols Outlined';font-style:normal">workspace_premium</span>
        </div>
        <p class="text-4xl font-black text-primary-container">@totalRecs</p>
        <p class="text-xs text-on-surface-variant mt-1">total enviados</p>
    </div>
    <div class="card p-6">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Pendentes</span>
            <span class="ms text-secondary" style="font-size:28px;font-family:'Material Symbols Outlined';font-style:normal">pending_actions</span>
        </div>
        <p class="text-4xl font-black text-primary-container">@pendingAp</p>
        <p class="text-xs text-on-surface-variant mt-1">aguardando aprovação</p>
    </div>
    <div class="card p-6">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Pontos Emitidos</span>
            <span class="ms text-secondary" style="font-size:28px;font-family:'Material Symbols Outlined';font-style:normal">stars</span>
        </div>
        <p class="text-4xl font-black text-primary-container">@totalPts.ToString("N0")</p>
        <p class="text-xs text-on-surface-variant mt-1">pts em circulação</p>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <a href="/admin/users" class="card p-6 hover:shadow-lg transition-all flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:#0b1b3d">
            <span class="ms text-white" style="font-family:'Material Symbols Outlined';font-style:normal">group</span>
        </div>
        <div>
            <p class="font-bold text-primary-container">Gerenciar Usuários</p>
            <p class="text-xs text-on-surface-variant">Convidar, editar, desativar</p>
        </div>
    </a>
    <a href="/admin/company-values" class="card p-6 hover:shadow-lg transition-all flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:#00658d">
            <span class="ms text-white" style="font-family:'Material Symbols Outlined';font-style:normal">star</span>
        </div>
        <div>
            <p class="font-bold text-primary-container">Valores da Empresa</p>
            <p class="text-xs text-on-surface-variant">Tags de reconhecimento</p>
        </div>
    </a>
    <a href="/admin/budgets" class="card p-6 hover:shadow-lg transition-all flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:#567bff">
            <span class="ms text-white" style="font-family:'Material Symbols Outlined';font-style:normal">account_balance_wallet</span>
        </div>
        <div>
            <p class="font-bold text-primary-container">Orçamentos</p>
            <p class="text-xs text-on-surface-variant">Distribuir pontos aos gestores</p>
        </div>
    </a>
    <a href="/admin/surveys" class="card p-6 hover:shadow-lg transition-all flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:#004b69">
            <span class="ms text-white" style="font-family:'Material Symbols Outlined';font-style:normal">poll</span>
        </div>
        <div>
            <p class="font-bold text-primary-container">Pesquisas</p>
            <p class="text-xs text-on-surface-variant">eNPS, Pulso, ESAT</p>
        </div>
    </a>
    <a href="/admin/marketplace" class="card p-6 hover:shadow-lg transition-all flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:#0039b5">
            <span class="ms text-white" style="font-family:'Material Symbols Outlined';font-style:normal">redeem</span>
        </div>
        <div>
            <p class="font-bold text-primary-container">Marketplace</p>
            <p class="text-xs text-on-surface-variant">Produtos e recompensas</p>
        </div>
    </a>
    <a href="/approvals" class="card p-6 hover:shadow-lg transition-all flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:#ba1a1a">
            <span class="ms text-white" style="font-family:'Material Symbols Outlined';font-style:normal">fact_check</span>
        </div>
        <div>
            <p class="font-bold text-primary-container">Aprovações</p>
            <p class="text-xs text-on-surface-variant">Revisar reconhecimentos</p>
        </div>
    </a>
</div>
