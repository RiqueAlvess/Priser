@using Priser.Models.Entities
@{
    ViewBag.Title = "Valores da Empresa – Admin";
    var values = ViewBag.Values as List<CompanyValue> ?? [];
}

<header class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-3xl font-bold text-primary-container">Valores da Empresa</h1>
        <a href="/admin" class="text-secondary text-sm hover:underline">← Admin</a>
    </div>
    <button onclick="document.getElementById('create-modal').classList.remove('hidden')" class="btn-primary flex items-center gap-2">
        <span class="ms" style="font-size:16px;font-family:'Material Symbols Outlined';font-style:normal">add</span> Novo Valor
    </button>
</header>

@if (!values.Any())
{
    <div class="card p-12 text-center">
        <span class="ms block mb-4 text-outline" style="font-size:64px;font-family:'Material Symbols Outlined';font-style:normal">star</span>
        <h3 class="text-xl font-semibold text-primary-container">Nenhum valor cadastrado</h3>
        <p class="text-on-surface-variant mt-2">Crie os valores culturais da sua empresa.</p>
    </div>
}
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
    @foreach (var v in values)
    {
        <div class="card p-5 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0" style="background:@(v.Color)22">
                <span class="ms" style="font-size:24px;font-family:'Material Symbols Outlined';font-style:normal;color:@v.Color">@(v.Icon ?? "star")</span>
            </div>
            <div class="flex-1 min-w-0">
                <p class="font-bold text-primary-container">@v.Name</p>
                @if (v.Description != null)
                {
                    <p class="text-xs text-on-surface-variant truncate">@v.Description</p>
                }
            </div>
            <div class="w-3 h-3 rounded-full flex-shrink-0" style="background:@v.Color"></div>
        </div>
    }
</div>

<!-- Create Modal -->
<div id="create-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-8 w-full max-w-md shadow-2xl">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-primary-container">Novo Valor Cultural</h2>
            <button onclick="document.getElementById('create-modal').classList.add('hidden')" class="text-on-surface-variant hover:text-primary-container">
                <span class="ms" style="font-family:'Material Symbols Outlined';font-style:normal">close</span>
            </button>
        </div>
        <form method="post" action="/admin/company-values/create">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Nome *</label>
                <input type="text" name="name" required placeholder="Ex: Inovação" class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary"/>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Descrição</label>
                <textarea name="description" rows="2" placeholder="Descreva este valor..." class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary resize-none"></textarea>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Ícone (Material Symbols)</label>
                <input type="text" name="icon" placeholder="Ex: lightbulb, star, handshake" class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary"/>
            </div>
            <div class="mb-6">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Cor *</label>
                <input type="color" name="color" value="#00658d" class="w-full h-12 border border-outline-variant rounded-xl px-2 cursor-pointer"/>
            </div>
            <div class="flex gap-3">
                <button type="button" onclick="document.getElementById('create-modal').classList.add('hidden')" class="btn-outline flex-1">Cancelar</button>
                <button type="submit" class="btn-primary flex-1">Criar Valor</button>
            </div>
        </form>
    </div>
</div>
