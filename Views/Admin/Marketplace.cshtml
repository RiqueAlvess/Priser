@using Priser.Models.Entities
@{
    ViewBag.Title = "Marketplace – Admin";
    var products = ViewBag.Products as List<Product> ?? [];
}

<header class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-3xl font-bold text-primary-container">Gerenciar Marketplace</h1>
        <a href="/admin" class="text-secondary text-sm hover:underline">← Admin</a>
    </div>
    <button onclick="document.getElementById('product-modal').classList.remove('hidden')" class="btn-primary flex items-center gap-2">
        <span class="ms" style="font-size:16px;font-family:'Material Symbols Outlined';font-style:normal">add</span> Novo Produto
    </button>
</header>

<div class="card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead style="background:#f3f4f5">
                <tr>
                    <th class="text-left px-6 py-3 text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Produto</th>
                    <th class="text-left px-6 py-3 text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Categoria</th>
                    <th class="text-left px-6 py-3 text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Preço</th>
                    <th class="text-left px-6 py-3 text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Estoque</th>
                    <th class="text-left px-6 py-3 text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @foreach (var p in products)
                {
                    <tr class="hover:bg-surface-container transition-colors">
                        <td class="px-6 py-4">
                            <p class="font-semibold text-primary-container">@p.Name</p>
                            @if (p.Description != null)
                            {
                                <p class="text-xs text-on-surface-variant truncate max-w-xs">@p.Description</p>
                            }
                        </td>
                        <td class="px-6 py-4 text-on-surface-variant">@p.Category</td>
                        <td class="px-6 py-4 font-bold text-secondary">@p.PricePoints.ToString("N0") pts</td>
                        <td class="px-6 py-4 text-on-surface-variant">@(p.StockQuantity?.ToString() ?? "Ilimitado")</td>
                        <td class="px-6 py-4">
                            <span class="text-xs px-2 py-1 rounded-full font-semibold @(p.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                @(p.IsActive ? "Ativo" : "Inativo")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!products.Any())
        {
            <div class="p-12 text-center">
                <span class="ms block mb-4 text-outline" style="font-size:48px;font-family:'Material Symbols Outlined';font-style:normal">redeem</span>
                <p class="text-on-surface-variant">Nenhum produto cadastrado.</p>
            </div>
        }
    </div>
</div>

<!-- Product Modal -->
<div id="product-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-8 w-full max-w-md shadow-2xl max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-primary-container">Novo Produto</h2>
            <button onclick="document.getElementById('product-modal').classList.add('hidden')" class="text-on-surface-variant">
                <span class="ms" style="font-family:'Material Symbols Outlined';font-style:normal">close</span>
            </button>
        </div>
        <form method="post" action="/admin/marketplace/create">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Nome *</label>
                <input type="text" name="name" required class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary"/>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Descrição</label>
                <textarea name="description" rows="2" class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary resize-none"></textarea>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">URL da Imagem</label>
                <input type="url" name="imageUrl" placeholder="https://..." class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary"/>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Preço em Pontos *</label>
                <input type="number" name="pricePoints" required min="1" class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary"/>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Categoria *</label>
                <input type="text" name="category" required placeholder="Ex: Vouchers, Eletrônicos, Experiências" class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary"/>
            </div>
            <div class="mb-6">
                <label class="block text-sm font-semibold mb-1.5 text-primary-container">Quantidade em Estoque</label>
                <input type="number" name="stockQuantity" min="0" placeholder="Deixe em branco para ilimitado" class="w-full border border-outline-variant rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-secondary"/>
            </div>
            <div class="flex gap-3">
                <button type="button" onclick="document.getElementById('product-modal').classList.add('hidden')" class="btn-outline flex-1">Cancelar</button>
                <button type="submit" class="btn-primary flex-1">Adicionar Produto</button>
            </div>
        </form>
    </div>
</div>
